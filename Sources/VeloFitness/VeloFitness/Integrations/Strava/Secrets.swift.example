// Secrets.swift — COPY this file to Secrets.swift and fill in your credentials.
// Secrets.swift is gitignored and must never be committed.
//
// How to get your Strava API credentials:
//   1. Go to https://www.strava.com/settings/api
//   2. Create an application (any name/website is fine for personal use)
//   3. Set the "Authorization Callback Domain" to: localhost
//   4. Copy the Client ID and Client Secret below

enum StravaSecrets {
    static let clientID     = "YOUR_STRAVA_CLIENT_ID"
    static let clientSecret = "YOUR_STRAVA_CLIENT_SECRET"
}
